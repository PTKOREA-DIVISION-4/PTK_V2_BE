# ==============================================================================
# PTKOREA Factbook Generator Backend — Environment Variables (.env)
# Copy this file to `backend/.env` and fill in your credentials.
# Never commit `backend/.env` or expose these keys to `frontend/`.
# ==============================================================================

APP_NAME="PTKOREA Factbook API"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX=""

# --- MySQL Database (utf8mb4 required for Korean + SNS emojis) ---
DATABASE_URL="mysql+aiomysql://factbook:factbook_pw@127.0.0.1:3306/factbook?charset=utf8mb4"
DATABASE_SYNC_URL="mysql+pymysql://factbook:factbook_pw@127.0.0.1:3306/factbook?charset=utf8mb4"
DB_AUTO_CREATE_TABLES=true

# --- External Data & AI API Keys ---
PERPLEXITY_API_KEY=""
ANTHROPIC_API_KEY=""
SCRAPECREATORS_API_KEY=""
APIFY_API_TOKEN=""

# NAVER Cloud Platform (NAVER API HUB: DataLab Search Trend & Shopping Insight)
# Both underscore (`X_NCP_APIGW_API_KEY_ID`) and hyphen (`X-NCP-APIGW-API-KEY-ID`) aliases are supported.
X_NCP_APIGW_API_KEY_ID=""
X_NCP_APIGW_API_KEY=""

# --- Model & Provider Endpoints ---
PERPLEXITY_BASE_URL="https://api.perplexity.ai"
PERPLEXITY_MODEL="sonar-pro"

ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODEL="claude-sonnet-5-5"

SCRAPECREATORS_BASE_URL="https://api.scrapecreators.com"
APIFY_BASE_URL="https://api.apify.com/v2"
NAVER_APIGW_BASE_URL="https://naverapihub.apigw.ntruss.com"

# Default Naver Shopping Insight Category ID fallback (e.g. 50000002 = 화장품/미용)
DEFAULT_NAVER_SHOPPING_CATEGORY_ID="50000002"

# --- Concurrency, Cache & Storage ---
STORAGE_ROOT="./storage"
CACHE_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=45.0
MAX_CONCURRENT_PERPLEXITY=3
MAX_CONCURRENT_NAVER=5
MAX_CONCURRENT_SCRAPECREATORS=4
MAX_CONCURRENT_APIFY=3
MAX_CONCURRENT_ANTHROPIC=3
